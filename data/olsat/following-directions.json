        {
          "id": "d",
          "figure": {
            "text": "🐈🐈🌳"
          },
          "label": "cat, cat, tree"
        }
      ],
      "answer": "a",
      "explanation": "In the middle means with one thing on each side. Only choice a has the cat between the two trees.",
      "strategy": "Middle means one thing on the left and one on the right."
