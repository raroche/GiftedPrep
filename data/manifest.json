    {
      "id": "cogat",
      "name": "CogAT",
      "fullName": "Cognitive Abilities Test",
      "publisher": "Riverside Insights",
      "icon": "puzzle",
      "blurb": "Nine kinds of puzzle in three groups: words, numbers and shapes.",
      "detail": "The most widely used gifted screener in the United States. Grades K-2 see pictures only and nothing is timed. From grade 3 the words and numbers become text, and each of the nine parts gets exactly ten minutes.",
      "batteries": [
        {
          "id": "verbal",
          "name": "Verbal",
          "blurb": "Reasoning with words and pictures of things."
        },
        {
          "id": "quantitative",
          "name": "Quantitative",
          "blurb": "Reasoning with amounts and numbers."
        },
        {
          "id": "nonverbal",
          "name": "Nonverbal",
          "blurb": "Reasoning with shapes. No words at all."
        }
      ]
    },
    {
      "id": "nnat",
      "name": "NNAT",
      "fullName": "Naglieri Nonverbal Ability Test",
      "publisher": "Pearson",
      "icon": "shapes",
      "blurb": "Shape puzzles only. No words, no numbers, no reading.",
      "detail": "48 questions in 30 minutes, at every grade. Built to be fair to children who are still learning English, so it uses only geometric shapes in five colors: black, white, yellow, blue and green.",
      "batteries": [
        {
          "id": "nonverbal",
          "name": "Nonverbal",
          "blurb": "Every NNAT question is a shape puzzle."
        }
      ]
    },
    {
      "id": "olsat",
      "name": "OLSAT",
      "fullName": "Otis-Lennon School Ability Test, 8th Edition",
      "publisher": "Pearson",
      "icon": "book",
      "blurb": "The widest mix: listening, words, pictures, shapes and numbers.",
      "detail": "In grades K-2 a teacher reads every question aloud, once, and children answer with pictures. From grade 3 the test changes almost completely: children read for themselves and number puzzles appear.",
      "batteries": [
        {
          "id": "verbal-comprehension",
          "name": "Verbal Comprehension",
          "blurb": "Understanding what you hear or read."
        },
        {
          "id": "verbal-reasoning",
          "name": "Verbal Reasoning",
          "blurb": "Working things out from what you are told."
        },
        {
          "id": "pictorial-reasoning",
          "name": "Pictorial Reasoning",
          "blurb": "Reasoning with pictures of real things."
        },
        {
          "id": "figural-reasoning",
          "name": "Figural Reasoning",
          "blurb": "Reasoning with abstract shapes."
        },
        {
          "id": "quantitative-reasoning",
          "name": "Quantitative Reasoning",
          "blurb": "Finding patterns in numbers."
        }
      ]
    }
